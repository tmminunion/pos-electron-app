{
  "name": "pos-electron-app",
  "version": "1.0.3",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.nufat.datacenter",
    "productName": "DataCenter POS",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tmminunion",
        "repo": "pos-electron-app"
      }
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ]
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
